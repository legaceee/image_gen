# Hugging Face Inference API Token
# Obtain a free token with "read" access from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional alias (supported automatically)
HF_TOKEN=

# Model Preferences (Optional - sensible defaults are pre-configured)
# Generation Model (e.g., black-forest-labs/FLUX.1-schnell or stabilityai/stable-diffusion-xl-base-1.0)
HF_IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell

# Detection Model (e.g., umm-maybe/AI-image-detector)
HF_IMAGE_DETECT_MODEL=umm-maybe/AI-image-detector
